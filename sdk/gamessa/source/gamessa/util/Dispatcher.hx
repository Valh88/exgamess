package gamessa.util;

/**
	Маршалинг колбэков SDK в поток приложения.

	На sys-таргетах (hl/cpp) транспорт и HTTP доставляют события из фоновых
	потоков, а UI/игровые фреймворки требуют вызовов из главного потока.
	Приложение перенаправляет колбэки, задав `Dispatcher.post` один раз при
	старте, например для очереди главного потока:

	    Dispatcher.post = f -> mainThreadQueue.push(f);

	По умолчанию колбэки вызываются как есть (JS — однопоточно).
*/
class Dispatcher {
	public static var post:(Void->Void) -> Void = f -> f();
}
